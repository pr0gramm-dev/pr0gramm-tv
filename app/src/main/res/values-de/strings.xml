    <!-- Help panel next to a settings list (ui/launcher/settings/SettingsHelp.kt, NightList.kt). -->
    <string name="help_general_scope">Gilt für die ganze App.</string>
    <string name="help_server_intro">Die Adresse, von der die App den Katalog lädt. OK öffnet ein Feld für eine neue Adresse.</string>
    <string name="help_server_note">Nach dem Speichern einer anderen Adresse startet die App neu. Meine Liste und Weiterschauen gelten je Server.</string>
    <string name="help_controls_intro">Welche Taste was macht: auf der Startseite, auf einer Seite und im Vollbild.</string>
    <string name="help_controls_topic">Das Wichtigste</string>
    <string name="help_controls_topic_text">Das Zahnrad öffnet überall das Menü dessen, was gerade gewählt ist. Auf einer Seite wechselt OK halten zwischen Maus und Fokus, Zurück halten führt zur Startseite.</string>
    <string name="help_controls_note">OK zeigt alle Tasten.</string>
    <string name="help_about_intro">Version der App, Stand des Katalogs, der Server und wann zuletzt gesucht wurde.</string>
    <string name="help_check_intro">Fragt GitHub nach einer neuen Version dieser App. Eine neue Version wird geladen und beim nächsten Besuch der Startseite installiert.</string>
    <string name="help_check_note">Passiert auch von selbst, wenn die Startseite erscheint (höchstens stündlich).</string>
    <string name="help_pointer_intro">So sieht der Mauszeiger auf Seiten mit der Steuerung Maus aus.</string>
    <string name="help_pointer_hand">Eine orange Hand wie am Mac; geklickt wird mit der Fingerspitze.</string>
    <string name="help_pointer_glow">Ein leuchtender Punkt wie ein Laserpointer; geklickt wird in der Mitte.</string>
    <!-- Language row (data/appsettings LanguageChoice): row value and help option name; "English" and "Deutsch" are not resources (AC5). -->
    <string name="language_system">Systemsprache</string>
    <string name="help_language_intro">Die Sprache aller Texte der App. OK wählt die nächste Sprache.</string>
    <string name="help_language_system">Die Sprache des Fernsehers, wenn die App sie hat. Sonst Englisch.</string>
    <string name="help_language_english">Alle Texte der App auf Englisch.</string>
    <string name="help_language_german">Alle Texte der App auf Deutsch.</string>
    <string name="help_language_note">Seiten bekommen dieselbe Sprache als Wunsch. Texte aus dem Katalog ändern sich nicht.</string>
    <string name="help_zoom_intro">Macht Schrift, Bilder und Knöpfe der ganzen Seite größer oder kleiner.</string>
    <string name="help_zoom_note">◀ ▶ ändern die Größe in Schritten. Vorgabe für %1$s: %2$d\u00A0%%.</string>
    <string name="help_layout_normal">Die Seite bekommt ihre Fassung für Android.</string>
    <string name="help_layout_desktop">Die Seite hält den Fernseher für einen Computer und zeigt ihre volle Fassung. Hilft, wenn etwas fehlt oder die Seite zu grob aussieht.</string>
    <string name="help_blocklist_on">Nichts von bekannten Werbe- und Tracker-Adressen wird geladen: weniger Pop-ups, die Seite lädt schneller.</string>
    <string name="help_blocklist_off">Alles wird geladen. Nötig, wenn die Seite oder ein Video sonst nicht startet.</string>
    <string name="help_favorite_yes">Steht im Block „Seiten“ vorne und trägt einen Stern.</string>
    <string name="help_favorite_no">Steht nach den Favoriten; zuletzt benutzte Seiten weiter vorn.</string>
    <string name="help_favorite_note">Geht auch im Menü der Kachel (Zahnrad oder OK halten).</string>
    <string name="help_reset_intro">Setzt alle Einstellungen dieser Seite auf die Vorgaben zurück.</string>
    <string name="help_reset_note">Meine Liste, Weiterschauen und Anmeldungen auf der Seite bleiben.</string>
    <string name="help_control_focus">Die Pfeiltasten bewegen den Fokus von Link zu Link, OK öffnet ihn.</string>
    <string name="help_control_pointer">Die Pfeiltasten bewegen den Mauszeiger, OK klickt. Für Seiten, auf denen der Fokus nicht alles erreicht.</string>
    <string name="help_control_note">Geht auch auf der Seite: OK halten wechselt; die Seite merkt sich die Wahl.</string>
    <string name="help_active">eingestellt</string>
