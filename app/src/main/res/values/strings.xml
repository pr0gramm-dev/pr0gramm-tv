    <!-- Help panel next to a settings list (ui/launcher/settings/SettingsHelp.kt, NightList.kt). -->
    <string name="help_general_scope">Applies to the whole app.</string>
    <string name="help_server_intro">The address from which the app loads the catalog. Press OK to type a new address.</string>
    <string name="help_server_note">When you save a different address, the app restarts. Each server has its own My List and Continue Watching.</string>
    <string name="help_controls_intro">Shows what each key does on the home screen, on a page and in full screen.</string>
    <string name="help_controls_topic">The basics</string>
    <string name="help_controls_topic_text">Gear opens the menu of the selected item on every screen. On a page, hold OK to switch between Pointer and Focus. Hold Back to go to the home screen.</string>
    <string name="help_controls_note">Press OK to show all keys.</string>
    <string name="help_about_intro">The app version, the catalog version, the server and the time of the last update check.</string>
    <string name="help_check_intro">Asks GitHub for a new version of this app. The app downloads a new version and installs it on the next visit to the home screen.</string>
    <string name="help_check_note">The app also checks by itself when the home screen opens, at most once an hour.</string>
    <string name="help_pointer_intro">The look of the pointer on sites with the control Pointer.</string>
    <string name="help_pointer_hand">An orange hand, as on a Mac. The click is at the fingertip.</string>
    <string name="help_pointer_glow">A bright dot, like the dot of a laser. The click is at its center.</string>
    <!-- Language row (data/appsettings LanguageChoice): row value and help option name; "English" and "Deutsch" are not resources (AC5). -->
    <string name="language_system">System language</string>
    <string name="help_language_intro">The language of all app texts. Press OK to set the next language.</string>
    <string name="help_language_system">The language of the TV. If the app does not have that language, the app uses English.</string>
    <string name="help_language_english">All app texts in English.</string>
    <string name="help_language_german">All app texts in German.</string>
    <string name="help_language_note">The app asks sites for the app language. Texts from the catalog do not change.</string>
    <string name="help_zoom_intro">Makes the text, images and buttons of the whole page larger or smaller.</string>
    <string name="help_zoom_note">Press ◀ ▶ to change the size in steps. Default for %1$s: %2$d%%.</string>
    <string name="help_layout_normal">The site shows its layout for Android.</string>
    <string name="help_layout_desktop">The site thinks that the TV is a computer and shows its full layout. Use Computer when parts are missing or the site looks too coarse.</string>
    <string name="help_blocklist_on">The app loads nothing from known ad and tracker domains. You get fewer pop-ups. The page loads faster.</string>
    <string name="help_blocklist_off">The app loads everything. Use Off when the page does not load or a video does not start with On.</string>
    <string name="help_favorite_yes">The site is at the front of the Sites row and has a star.</string>
    <string name="help_favorite_no">The site comes after the favorites. Recently opened sites come earlier.</string>
    <string name="help_favorite_note">You can also make the site a favorite in the tile menu. To open the tile menu, press Gear or hold OK.</string>
    <string name="help_reset_intro">Sets all settings of this site back to the defaults.</string>
    <string name="help_reset_note">My List, Continue Watching and your logins on the site do not change.</string>
    <string name="help_control_focus">The arrow keys move the focus from link to link. OK opens the link.</string>
    <string name="help_control_pointer">The arrow keys move the pointer. OK clicks. Use Pointer on sites where the focus cannot reach all parts.</string>
    <string name="help_control_note">You can also hold OK on a page to change the control. The app keeps the choice for the site.</string>
