<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The self-update installs without asking (AC11); only the first update after an adb install may ask. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Which apps of the manifest are installed, and which can be started (AC9). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: http is wanted in every build (debug and release), for the server address,
         the catalog files and the sites. The user decides which address to trust.
         localeConfig: the app languages that LocaleManager and the Android settings offer (AC3). -->
    <application
        android:name=".app.TvApplication"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".app.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing" />

        <!-- The TV launcher knows the start page by this name; the alias keeps it after the move to .app (AC6). -->
        <activity-alias
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:targetActivity=".app.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".app.BrowserActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|screenSize|smallestScreenSize|screenLayout|orientation|density|fontScale" />

        <receiver
            android:name=".core.packageinstaller.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
